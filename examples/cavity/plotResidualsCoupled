set logscale y
set title "Residuals"
set ylabel 'Residual'
set xlabel 'Iteration'
set yrange[1e-7:1e+0]
plot "< cat monitor | grep 'L1 residuals' | cut -d' ' -f9 | tr -d ','" title 'Ux' with lines,\
     "< cat monitor | grep 'L1 residuals' | cut -d' ' -f11 | tr -d ','" title 'Uy' with lines,\
     "< cat monitor | grep 'L1 residuals' | cut -d' ' -f13 | tr -d ','" title 'Uz' with lines,\
     "< cat monitor | grep 'L1 residuals' | cut -d' ' -f15 | tr -d ','" title 'p' with lines
pause 5
reread

